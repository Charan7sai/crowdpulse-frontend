# Where the Flask backend runs (used by the Next.js server proxy)
BACKEND_URL=http://127.0.0.1:5001

# Where the browser loads the live video streams from.
# Must be reachable from the browser. Same machine: leave as is.
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5001

# Only needed if the backend has CAMERA_ADMIN_TOKEN set
# CAMERA_ADMIN_TOKEN=
